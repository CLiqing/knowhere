+            );
+        }
         cardinalv2::CardinalSearchStatistics statistics;
 #ifdef NOT_COMPILE_FOR_SWIG
         TimeRecorder rc("Search");
@@ -1129,6 +1134,11 @@ private:
             auto filter_count = bitset.count();
             auto total_count = bitset.size();
             cardinalv2::FilterCheckerView cardinal_bitset(bitset.data(), filter_count, total_count);
+            if (bitset.has_extra_filter()) {
+                cardinal_bitset.SetExtraFilter(
+                    bitset.extra_filter_ctx(), bitset.extra_filter_func(), bitset.extra_filtered_out_count()
+                );
+            }
 
             workspace_ = index_->CreateIteratorWorkspace(query, config, cardinal_bitset, op_context);
             if (range_radius.has_value()) {
