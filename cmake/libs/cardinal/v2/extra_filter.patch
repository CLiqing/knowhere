+                if (ForEmbList() && outer_id_to_internal_id_map_ != nullptr) {
+                    for (Idx outer_id = emb_list_offset_[bit_id];
+                         outer_id < emb_list_offset_[bit_id + 1] && valid_internal_ids.size() < num;
+                         ++outer_id) {
+                        valid_internal_ids.push_back(outer_id_to_internal_id_map_[outer_id]);
+                    }
+                    continue;
+                }
+                if (outer_id_to_internal_id_map_ != nullptr) {
+                    valid_internal_ids.push_back(outer_id_to_internal_id_map_[bit_id]);
+                } else {
+                    valid_internal_ids.push_back(bit_id);
+                }
+            }
+            return valid_internal_ids;
+        }
+
         if (ForEmbList() && outer_id_to_internal_id_map_ != nullptr) {
             // traverse bits
             //  bit id -> check bit validity ->  valid bit id (valid emb_list id) -> valid outer id -> valid internal id
@@ -251,6 +291,7 @@ private:

